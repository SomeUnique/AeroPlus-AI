# AeroPulse AI — environment configuration
# Copy to `.env` (backend reads it via pydantic-settings, prefix AEROPULSE_).

# --- server -------------------------------------------------------------------
AEROPULSE_HOST=127.0.0.1
AEROPULSE_PORT=8000
AEROPULSE_LOG_LEVEL=info

# --- telemetry simulation ------------------------------------------------------
# Frames per second (1.0 = 1 reading/sec)
AEROPULSE_TELEMETRY_HZ=1.0
# LEO orbital period in seconds (~96 min). Sunlight/eclipse cycles follow this.
AEROPULSE_ORBIT_PERIOD_S=5760.0
# Fraction of the orbit spent in eclipse (0.0 - 1.0)
AEROPULSE_ECLIPSE_FRACTION=0.35
# Deterministic run: set an integer for reproducible noise.
# Leave empty/unset for a fresh random scenario on every boot.
AEROPULSE_SEED=

# --- simulated communications (orbit / ground station / RF link) ----------------
# Everything below models a CubeSat + one ground station in software. No radio,
# no antenna and no real ground station is involved.

# Demo time acceleration: simulated seconds advanced per wall-clock second.
# 1 = real time, 600 = fastest. At 1x the onboard sampler still produces one
# reading per simulated second.
AEROPULSE_TIME_SCALE=1.0
# SIMULATED ground station. Raise FIRST_PASS_DELAY_S for accelerated demos so an
# operator has time to approve a command before AOS.
AEROPULSE_GROUND_STATION_NAME=Karachi GS (SIMULATED)
AEROPULSE_GROUND_STATION_LAT_DEG=24.86
AEROPULSE_GROUND_STATION_LON_DEG=67.00
AEROPULSE_GROUND_STATION_MIN_ELEVATION_DEG=10.0
# Orbit shape used for pass prediction
AEROPULSE_ORBIT_INCLINATION_DEG=35.0
# Mission-planning choice: first acquisition of signal this many sim-seconds in
AEROPULSE_FIRST_PASS_DELAY_S=15.0
# SIMULATED RF link
AEROPULSE_DOWNLINK_BPS=57600.0
AEROPULSE_LINK_ACQUIRING_S=8.0
AEROPULSE_LINK_BASE_PACKET_LOSS=0.02
AEROPULSE_LINK_BASE_CRC_ERROR=0.008
# Onboard store-and-forward buffer (packets) and uplink caps
AEROPULSE_ONBOARD_BUFFER_CAPACITY=8192
AEROPULSE_MAX_COMMANDS_PER_PASS=3
AEROPULSE_COMMAND_ACK_DELAY_S=3.0

# --- agent (Decide/Act) --------------------------------------------------------
# Toggle the co-pilot and pace its reasoning trace sent over /ws.
AEROPULSE_AGENT_ENABLED=true
# Delay between reasoning steps (seconds)
AEROPULSE_AGENT_STEP_DELAY_S=0.35
# Delay between action lifecycle stages: proposed -> executing -> succeeded
AEROPULSE_AGENT_ACTION_DELAY_S=0.6
# Delay before emitting a recovery report
AEROPULSE_AGENT_REPORT_DELAY_S=0.4

# --- frontend (enabled in a later phase) ---------------------------------------
AEROPULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
