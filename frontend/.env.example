# Backend endpoints for the AeroPulse AI mission-control UI.
# Defaults live in src/lib/config.ts (http://127.0.0.1:8000 and ws://127.0.0.1:8000/ws).
# Copy this file to .env.local and uncomment to point at another host/port.

# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
